{
  "manifest_version": 3,
  "name": "闲鱼电影票自动发货",
  "description": "闲鱼电影票报价、出票、自动发货助手",
  "version": "0.1.0",
  "action": {
    "default_title": "电影票发货",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "notifications", "alarms"],
  "host_permissions": [
    "http://172.30.1.151:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "https://www.goofish.com/*",
    "https://*.alicdn.com/*",
    "https://*.taobaocdn.com/*",
    "https://*.tbcdn.cn/*",
    "https://stream-upload.goofish.com/*",
    "https://aldsidle.agiso.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.goofish.com/*"],
      "js": ["js/xianyuContent.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://aldsidle.agiso.com/*"],
      "js": ["js/agisoContent.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["js/xianyuPageHook.js", "libs/msgpack.min.js"],
      "matches": ["https://www.goofish.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
